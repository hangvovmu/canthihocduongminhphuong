---
import { CLINIC } from '../data/clinic';
const links = [
  { href: '/', label: 'Dịch vụ' },
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/kien-thuc', label: 'Kiến thức' },
  { href: '/lien-he', label: 'Liên hệ' },
];
---

<footer class="border-t border-slate-200 bg-dark px-4 py-16 text-white sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.3fr_0.8fr_0.8fr]">
    <div>
      <a href="/" class="focus-ring flex items-center gap-3">
        <img src="/logo/minhphuong-logo.png" alt="Logo Minh Phương" class="h-10 w-auto" />
        <span class="text-lg font-semibold">{CLINIC.name}</span>
      </a>
      <p class="mt-4 max-w-md text-sm text-slate-300">
        Chuyên sâu về cận thị học đường, kiểm soát và bảo vệ thị lực cho học sinh bằng các giải pháp an toàn, khoa học và đáng tin cậy.
      </p>
    </div>
    <div>
      <h3 class="text-lg font-semibold">Liên hệ</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        <li>{CLINIC.address}</li>
        <li><a href={`tel:${CLINIC.phone}`} class="focus-ring hover:text-primary">{CLINIC.phoneDisplay}</a></li>
        <li>{CLINIC.hours}</li>
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold">Liên kết nhanh</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        {links.map((link) => (
          <li><a href={link.href} class="focus-ring hover:text-primary">{link.label}</a></li>
        ))}
      </ul>
      <div class="mt-4 flex gap-3">
        <a href={CLINIC.facebookUrl} target="_blank" rel="noreferrer" class="focus-ring rounded-full border border-slate-700 p-2 hover:border-primary hover:text-primary">Facebook</a>
        <a href={CLINIC.zaloUrl} target="_blank" rel="noreferrer" class="focus-ring rounded-full border border-slate-700 p-2 hover:border-primary hover:text-primary">Zalo</a>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-10 max-w-7xl border-t border-slate-800 pt-6 text-center text-sm text-slate-400">
    © 2026 Phòng Khám Mắt Cận Thị Học Đường Minh Phương. All rights reserved.
  </div>
  <div class="mx-auto mt-10 max-w-7xl border-t border-slate-800 pt-6 text-center text-sm text-slate-400">
    © 2026 PHÒNG KHÁM MẮT CẬN THỊ HỌC ĐƯỜNG MINH PHƯƠNG. All rights reserved.
  </div>
</footer>
