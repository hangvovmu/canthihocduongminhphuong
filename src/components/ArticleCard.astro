---
import { format } from 'date-fns';
const { entry } = Astro.props;
const formattedDate = format(entry.data.pubDate, 'dd/MM/yyyy');
---

<article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-soft">
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{entry.data.category}</p>
  <a href={`/kien-thuc/${entry.slug}`} class="focus-ring mt-3 block text-2xl font-semibold text-dark hover:text-primary">
    {entry.data.title}
  </a>
  <p class="mt-3 text-sm leading-7 text-slate-600">{entry.data.description}</p>
  <p class="mt-4 text-sm text-slate-500">{formattedDate}</p>
</article>
