---
import { CLINIC } from '../data/clinic';
const links = [
  { href: '/', label: 'Dịch vụ' },
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/kien-thuc', label: 'Kiến thức' },
  { href: '/lien-he', label: 'Liên hệ' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative mx-auto flex max-w-7xl items-center justify-between py-4">
      <a href="/" class="focus-ring flex items-center gap-3">
        <img src="/logo/minhphuong-logo.png" alt="Logo Minh Phương" class="h-10 w-auto" />
        <span class="text-lg font-semibold text-dark">{CLINIC.name}</span>
      </a>

      <nav class="hidden items-center gap-6 md:flex">
        {links.map((link) => (
          <a href={link.href} class="focus-ring text-sm font-medium text-dark transition hover:text-primary">
            {link.label}
          </a>
        ))}
        <a href={`tel:${CLINIC.phone}`} class="focus-ring rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90">
          Gọi đặt lịch
        </a>
      </nav>

      <button
        id="mobile-menu-button"
        type="button"
        class="focus-ring inline-flex rounded-full border border-slate-300 p-2 md:hidden"
        aria-label="Mở menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <nav
      id="mobile-menu-panel"
      class="hidden flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-soft md:hidden"
      aria-label="Menu di động"
    >
      {links.map((link) => (
        <a href={link.href} class="focus-ring rounded-xl px-3 py-2 text-sm font-medium text-dark transition hover:bg-slate-50 hover:text-primary">
          {link.label}
        </a>
      ))}
      <a href={`tel:${CLINIC.phone}`} class="focus-ring rounded-full bg-accent px-4 py-2 text-center text-sm font-semibold text-white transition hover:opacity-90">
        Gọi đặt lịch
      </a>
    </nav>
  </div>

  <script is:inline>
    const initMobileMenu = () => {
      if (document.documentElement.dataset.mobileMenuInitialized === 'true') {
        return;
      }
      document.documentElement.dataset.mobileMenuInitialized = 'true';

      const button = document.getElementById('mobile-menu-button');
      const panel = document.getElementById('mobile-menu-panel');

      if (!button || !panel) {
        return;
      }

      const setMenuState = (isOpen) => {
        button.setAttribute('aria-expanded', String(isOpen));
        button.setAttribute('aria-label', isOpen ? 'Đóng menu' : 'Mở menu');
        panel.classList.toggle('hidden', !isOpen);
        panel.classList.toggle('flex', isOpen);
      };

      button.addEventListener('click', (event) => {
        event.preventDefault();
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        setMenuState(!isOpen);
      });

      panel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setMenuState(false);
        });
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) {
          return;
        }
        if (!button.contains(target) && !panel.contains(target)) {
          setMenuState(false);
        }
      });
    };

    document.addEventListener('astro:page-load', initMobileMenu);
    document.addEventListener('DOMContentLoaded', initMobileMenu);
    initMobileMenu();
  </script>
</header>
