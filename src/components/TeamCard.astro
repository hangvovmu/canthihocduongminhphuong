---
const { name, title, image } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-soft">
  <img src={image} alt={`Ảnh ${name}`} class="mx-auto h-28 w-28 rounded-full object-cover" />
  <h3 class="mt-6 text-xl font-semibold text-dark">{name}</h3>
  <p class="mt-2 text-sm font-medium text-primary">{title}</p>
</article>
