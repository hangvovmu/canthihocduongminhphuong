---
interface Props {
  name: string;
  title: string;
  image: string;
  detailUrl?: string;
}

const { name, title, image, detailUrl } = Astro.props as Props;
---

<article class="group">
  <div class="relative rounded-3xl bg-bg-warm p-3">
    <div class="relative aspect-[3/4] overflow-hidden rounded-2xl">
      <img
        src={image}
        alt={`Ảnh ${name}`}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>

    <a
      href={detailUrl ?? '#'}
      aria-label={`Xem thông tin ${name}`}
      class="absolute bottom-1 left-1 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white shadow-soft transition-transform group-hover:scale-105"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>
  </div>

  <h3 class="mt-6 text-xl font-semibold text-dark">{name}</h3>
  <p class="mt-2 text-sm leading-6 text-slate-600">{title}</p>

  {detailUrl && (
    <a
      href={detailUrl}
      class="mt-4 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary/90"
    >
      Xem chi tiết
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>
  )}
</article>