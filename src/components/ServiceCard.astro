---
const { number, title, description } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-soft">
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{number}</p>
  <h3 class="mt-3 text-2xl font-semibold text-dark">{title}</h3>
  <p class="mt-4 text-sm leading-7 text-slate-600">{description}</p>
</article>
